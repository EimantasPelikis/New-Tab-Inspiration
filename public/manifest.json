{
  "manifest_version": 3,
  "name": "NewTab Inspiration",
  "description": "Replaces the new tab page with today's date, a live clock and an hourly quote.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://zenquotes.io/*"],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
